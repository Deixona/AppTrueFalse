<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Buzz">

    <TextView
        android:id="@+id/pregunta"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="Hello World!"
        android:textAlignment="center"
        android:layout_marginTop="25dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <Button
        android:id="@+id/botontrue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verdadero"

        app:layout_constraintTop_toBottomOf="@+id/pregunta"
        app:layout_constraintStart_toEndOf="@+id/botonfalse"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/botonfalse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Falso"

        app:layout_constraintTop_toBottomOf="@+id/pregunta"
        app:layout_constraintEnd_toStartOf="@+id/botontrue"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/botonnext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableRight="@android:drawable/ic_media_ff"
        android:text="Siguiente"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/botonfalse"
        app:layout_constraintTop_toBottomOf="@+id/botontrue"
        />

    <Button
        android:id="@+id/botonback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableLeft="@android:drawable/ic_media_rew"
        android:text="Atrás"

        app:layout_constraintTop_toBottomOf="@+id/botonfalse"
        app:layout_constraintEnd_toStartOf="@+id/botonnext"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/botonrandom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pregunta aleatoria"
        android:drawableBottom="@android:drawable/stat_notify_sync"

        app:layout_constraintTop_toBottomOf="@+id/botonnext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />


    <TextView
        android:id="@+id/respuesta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textAlignment="center"
        android:layout_marginTop="30dp"

        app:layout_constraintTop_toBottomOf="@id/botonrandom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textAlignment="center"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/respuesta"
        />

    <Button
        android:id="@+id/inicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inicio"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>