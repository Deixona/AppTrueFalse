<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Buzz">

    <TextView
        android:id="@+id/pregunta"
        style="@style/TextoPregunta"
        android:text=""
        android:layout_marginTop="@dimen/margenpregunta"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <Button
        android:id="@+id/botontrue"
        style="@style/Wrap"
        android:text="@string/botontrue"

        app:layout_constraintTop_toBottomOf="@+id/pregunta"
        app:layout_constraintStart_toEndOf="@+id/botonfalse"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/botonfalse"
        style="@style/Wrap"
        android:text="@string/botonfalse"

        app:layout_constraintTop_toBottomOf="@+id/pregunta"
        app:layout_constraintEnd_toStartOf="@+id/botontrue"
        app:layout_constraintStart_toStartOf="parent"
        />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/gruporeproductor"
        style="@style/Wrap"
        android:visibility="gone"

        app:constraint_referenced_ids="playopause,tiempototal,tiempotranscurrido,loop,seekbar,botonweb"
        />

    <ImageButton
        android:id="@+id/playopause"
        style="@style/BotonIcono"
        android:src="@drawable/play"

        app:layout_constraintTop_toBottomOf="@id/botonfalse"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tiempotranscurrido"
        />

    <TextView
        android:id="@+id/tiempotranscurrido"
        style="@style/Wrap"

        app:layout_constraintTop_toTopOf="@id/playopause"
        app:layout_constraintBottom_toBottomOf="@id/playopause"
        app:layout_constraintStart_toEndOf="@id/playopause"
        app:layout_constraintEnd_toStartOf="@id/seekbar"
        />

    <SeekBar
        android:id="@+id/seekbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toTopOf="@id/playopause"
        app:layout_constraintBottom_toBottomOf="@id/playopause"
        app:layout_constraintStart_toEndOf="@id/tiempotranscurrido"
        app:layout_constraintEnd_toStartOf="@id/tiempototal"
        />

    <TextView
        android:id="@+id/tiempototal"
        style="@style/Wrap"

        app:layout_constraintTop_toTopOf="@id/playopause"
        app:layout_constraintBottom_toBottomOf="@id/playopause"
        app:layout_constraintStart_toEndOf="@id/seekbar"
        app:layout_constraintEnd_toStartOf="@id/loop"
        />

    <ImageButton
        android:id="@+id/loop"
        style="@style/BotonIcono"
        android:src="@drawable/loop"

        app:layout_constraintTop_toTopOf="@id/playopause"
        app:layout_constraintBottom_toBottomOf="@id/playopause"
        app:layout_constraintStart_toEndOf="@id/tiempototal"
        app:layout_constraintEnd_toStartOf="@id/botonweb"
        />

    <ImageButton
        android:id="@+id/botonweb"
        style="@style/BotonIcono"
        android:src="@drawable/info"

        app:layout_constraintTop_toTopOf="@+id/playopause"
        app:layout_constraintBottom_toBottomOf="@+id/playopause"
        app:layout_constraintStart_toEndOf="@+id/loop"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/botonnext"
        style="@style/Wrap"
        android:drawableRight="@android:drawable/ic_media_ff"
        android:text="@string/botonnext"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/botonback"
        app:layout_constraintTop_toBottomOf="@+id/playopause"
        />

    <Button
        android:id="@+id/botonback"
        style="@style/Wrap"
        android:drawableLeft="@android:drawable/ic_media_rew"
        android:text="@string/botonback"

        app:layout_constraintTop_toBottomOf="@+id/playopause"
        app:layout_constraintEnd_toStartOf="@+id/botonnext"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/botonrandom"
        style="@style/Wrap"
        android:text="@string/botonrandom"
        android:drawableBottom="@android:drawable/stat_notify_sync"

        app:layout_constraintTop_toBottomOf="@+id/botonback"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/respuesta"
        style="@style/TextoCentrado"
        android:text=""
        android:layout_marginTop="@dimen/margenrespuesta"

        app:layout_constraintTop_toBottomOf="@id/botonrandom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/timer"
        style="@style/TextoCentrado"
        android:text=""

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/respuesta"
        />

    <Button
        android:id="@+id/inicio"
        style="@style/Wrap"
        android:text="@string/botoninicio"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>