<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".menuPrincipal">


    <TextView
        android:id="@+id/stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:textAlignment="center"
        android:text="Tus estadísticas"
        android:textSize="50dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="parent"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/aciertos"
        android:text="Aciertos"

        app:layout_constraintTop_toBottomOf="@id/stats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf = "@id/recuentoaciertos"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/recuentoaciertos"
        android:text=""

        app:layout_constraintTop_toBottomOf="@id/stats"
        app:layout_constraintEnd_toStartOf="@id/porcentajeaciertos"
        app:layout_constraintStart_toEndOf="@id/aciertos"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/porcentajeaciertos"
        android:text=""

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stats"
        app:layout_constraintStart_toEndOf="@+id/recuentoaciertos"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/fallos"
        android:text="Fallos"

        app:layout_constraintTop_toBottomOf="@id/aciertos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf = "@id/recuentofallos"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/recuentofallos"
        android:text=""

        app:layout_constraintTop_toBottomOf="@id/recuentoaciertos"
        app:layout_constraintEnd_toStartOf="@id/porcentajefallos"
        app:layout_constraintStart_toEndOf="@id/fallos"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/porcentajefallos"
        android:text=""

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/porcentajeaciertos"
        app:layout_constraintStart_toEndOf="@+id/recuentofallos"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/clicks"
        android:text="Clicks"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fallos"
        app:layout_constraintEnd_toStartOf="@+id/recuentoclicks"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/recuentoclicks"

        app:layout_constraintTop_toBottomOf="@id/recuentofallos"
        app:layout_constraintStart_toEndOf="@+id/clicks"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/inicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inicio"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>