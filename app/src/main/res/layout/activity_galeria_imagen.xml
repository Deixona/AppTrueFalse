<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GaleriaImagen">

    <TextView
        android:id="@+id/textogaleria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/galer_a_de_im_genes"
        android:textSize="30dp"
        android:paddingTop="20dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <ImageView
        android:id="@+id/imagenizquierda"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:src="@drawable/lalaguna"

        app:layout_constraintTop_toBottomOf="@id/textogaleria"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imagencentro"
        />

    <ImageView
        android:id="@+id/imagencentro"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:src="@drawable/lalaguna"

        app:layout_constraintTop_toBottomOf="@id/textogaleria"
        app:layout_constraintEnd_toStartOf="@id/imagenderecha"
        app:layout_constraintStart_toEndOf="@id/imagenizquierda"
        />

    <ImageView
        android:id="@+id/imagenderecha"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:src="@drawable/lalaguna"

        app:layout_constraintTop_toBottomOf="@id/textogaleria"
        app:layout_constraintStart_toEndOf="@id/imagencentro"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/textoimagen"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="sjdkasdjkasd"
        android:textAlignment="center"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imagencentro"
        app:layout_constraintStart_toStartOf="parent"

        />

    <Button
        android:id="@+id/siguiente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Siguiente"

        app:layout_constraintTop_toBottomOf="@+id/textoimagen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/anterior"
        />

    <Button
        android:id="@+id/anterior"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Anterior"

        app:layout_constraintTop_toBottomOf="@+id/textoimagen"
        app:layout_constraintEnd_toStartOf="@+id/siguiente"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/inicio"
        style="@style/Wrap"
        android:text="@string/botoninicio"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <ImageButton
        android:id="@+id/musica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:src="@drawable/altavozsonando"


        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight="40dp"
        app:layout_constraintWidth="40dp"
        />



</androidx.constraintlayout.widget.ConstraintLayout>